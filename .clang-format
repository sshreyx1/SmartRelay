# Layout rules of BARR-C:2018 as used by this repository (docs/CODING_STANDARD.md).
# Check:  tools/check_style.sh          Format:  clang-format -i <file>   (clang-format 18+)
BasedOnStyle: LLVM
IndentWidth: 4                      # 3.4.a
TabWidth: 4
UseTab: Never                       # 3.5.a
ColumnLimit: 80                     # 1.2.a
BreakBeforeBraces: Allman           # 1.3.b
InsertBraces: true                  # 1.3.a
SpaceBeforeParens: Custom           # 3.1.a, 3.1.j
SpaceBeforeParensOptions:
  AfterControlStatements: true
  AfterForeachMacros: true
  AfterFunctionDefinitionName: true
  AfterFunctionDeclarationName: false
  AfterIfMacros: true
  AfterOverloadedOperator: false
  BeforeNonEmptyParentheses: false
IndentCaseLabels: true              # 3.4.b
AlignConsecutiveDeclarations: Consecutive   # 3.2.a, 3.2.b
AlignConsecutiveAssignments: Consecutive    # 3.2.c
AlignConsecutiveMacros: Consecutive
AlignTrailingComments: true
AlignAfterOpenBracket: Align
PointerAlignment: Left
ReferenceAlignment: Left
IndentPPDirectives: None            # 3.2.d: '#' stays in column 0
AllowShortIfStatementsOnASingleLine: Never  # 3.3.a
AllowShortLoopsOnASingleLine: false
AllowShortBlocksOnASingleLine: Never
AllowShortFunctionsOnASingleLine: None
AllowShortCaseLabelsOnASingleLine: false
AllowShortEnumsOnASingleLine: false
KeepEmptyLinesAtTheStartOfBlocks: false
MaxEmptyLinesToKeep: 1
KeepEmptyLinesAtEOF: true           # 3.3.c: blank line after the end-of-file comment
SortIncludes: Never
IncludeBlocks: Preserve
ReflowComments: false             # comments are wrapped by hand so tables stay readable
